#!/bin/sh
set -eu

skills_dir="$HOME/dotfiles/config/ai/skills"
opencode_commands_src="$HOME/dotfiles/config/opencode/commands"
opencode_config_dir="$HOME/.config/opencode"
opencode_skills_dir="$HOME/.config/opencode/skills"
claude_skills_dir="$HOME/.claude/skills"
agents_skills_dir="$HOME/.agents/skills"
pi_skills_dir="$HOME/.pi/agent/skills"

link_skill() {
  root_dir="$1"
  dest_dir="$root_dir/$name"

  if [ -d "$dest_dir" ] && [ ! -L "$dest_dir" ]; then
    ln -sf "$skill_file" "$dest_dir/SKILL.md"
  else
    ln -sfn "$skill_dir" "$dest_dir"
  fi
}

mkdir -p "$opencode_config_dir" "$opencode_skills_dir" "$claude_skills_dir" "$agents_skills_dir" "$pi_skills_dir"
ln -sfn "$opencode_commands_src" "$opencode_config_dir/commands"

for skill_file in "$skills_dir"/*/SKILL.md; do
  [ -f "$skill_file" ] || continue

  skill_dir=$(dirname "$skill_file")
  name=$(basename "$skill_dir")

  link_skill "$opencode_skills_dir"
  link_skill "$claude_skills_dir"
  link_skill "$agents_skills_dir"
  link_skill "$pi_skills_dir"
done
