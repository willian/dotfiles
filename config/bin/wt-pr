#!/bin/bash
# Open (or create) the worktree for a GitHub PR's branch, then its tmux session.
# gh runs through mise for the work GH_TOKEN, and the branch is opened by name,
# which also works with SSH host-alias remotes.
# Usage: wt-pr <pr-number>
set -u

pause() { printf '\n%s\nPress Enter.' "$1"; read -r _; exit 1; }

[[ "${1:-}" =~ ^[0-9]+$ ]] || pause "Not a PR number: '${1:-}'"

info=$(mise exec -- gh pr view "$1" --json headRefName,isCrossRepository \
  -q '[.headRefName, .isCrossRepository] | @tsv') || pause "Could not fetch PR #$1"
IFS=$'\t' read -r branch cross <<<"$info"
[ "$cross" = false ] || pause "PR #$1 comes from a fork; not supported."

# A branch only on the remote: wt makes the local tracking branch from origin/<name>
git show-ref --verify --quiet "refs/heads/$branch" || git fetch -q origin "$branch" || pause "Could not fetch $branch"

wt switch "$branch" --no-cd -x "$HOME/.config/bin/wt-open" -- '{{ repo }}/{{ branch | sanitize }}' '{{ worktree_path }}' ||
  pause "wt switch failed for $branch"
