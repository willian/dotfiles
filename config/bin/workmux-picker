#!/usr/bin/env bash

set -euo pipefail

mode="${1:-open}"

case "$mode" in
  open|remove) ;;
  *)
    echo "Usage: workmux-picker {open|remove}" >&2
    exit 1
    ;;
esac

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "workmux-picker: run inside a git repository" >&2
  exit 1
}

if [[ "$mode" == open ]]; then
  worktree_branches="$(git worktree list --porcelain |
    awk '/^branch refs\/heads\// { sub("^branch refs/heads/", ""); print }' |
    sort -u)"
  mapfile -t selection < <(
    {
      [[ -z "$worktree_branches" ]] || printf '%s\n' "$worktree_branches"
      git for-each-ref --format='%(refname:short)' refs/heads |
        awk -v worktrees="$worktree_branches" '
          BEGIN { split(worktrees, branches, "\\n"); for (i in branches) attached[branches[i]] = 1 }
          !attached[$0]
        '
      git for-each-ref --format='%(refname) %(refname:short)' refs/remotes/origin |
        awk '$1 !~ /\/HEAD$/ { print $2 }'
    } | awk '!seen[$0]++' |
      fzf --print-query --reverse --prompt='Worktree> ' \
        --header='Enter: switch or create branch · Esc: cancel'
  )

  target="${selection[1]:-${selection[0]:-}}"
  [[ -n "$target" ]] || exit 0
  git check-ref-format --branch "$target" >/dev/null || {
    echo "workmux-picker: invalid branch name: $target" >&2
    exit 1
  }
  exec workmux add --open-if-exists "$target"
fi

mapfile -t selection < <(
  workmux list --json |
    jq -r '.[] | select(.is_main | not) | [(.branch // .handle), .handle] | @tsv' |
    fzf --delimiter=$'\t' --with-nth=1 --prompt='Remove worktree> ' \
      --header='Enter: remove selected worktree · Esc: cancel'
)

[[ -n "${selection[0]:-}" ]] || exit 0
target="${selection[0]##*$'\t'}"
exec workmux remove "$target"
