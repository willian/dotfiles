#!/usr/bin/env bash
# Session picker: sesh sessions/configs/zoxide plus worktrunk worktrees across repos.
# Inside a Rex terminal it lists Rex sessions through sex instead of tmux's.
# Lines are "display<TAB>name<TAB>worktree path<TAB>path<TAB>main checkout path"
# (worktree path and main checkout only on worktrees).
set -u
shopt -s nullglob

rex=${REX_SESSION:+1}
wt_icon=$''

# Worktrees under ~/Code, in the <repo>__worktrees dirs worktrunk's config puts
# them in, named <repo>/<dir> as wt-open names their sessions; green when open
worktrees() {
  local open d parent repo name color
  if [ -n "$rex" ]; then
    open=$(rex ls --json | jq -r '.sessions[].label')
  else
    open=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  fi
  for d in ~/Code/*__worktrees/*/ ~/Code/*/*__worktrees/*/ ~/Code/*/*/*__worktrees/*/; do
    [ -f "$d.git" ] && [ -d "$(sed -n 's/^gitdir: //p' "$d.git")" ] || continue # a leftover, not a worktree
    d=${d%/} parent=${d%/*}
    repo=${parent##*/} repo=${repo%__worktrees}
    name=$(tr '.:' '__' <<<"$repo/${d##*/}") # as wt-open names the session
    grep -qxF "$name" <<<"$open" && color=32 || color=90
    printf '\e[%sm%s\e[39m %s\t%s\t%s\t%s\t%s\n' "$color" "$wt_icon" "$name" "$name" "$d" "$d" "${parent%/*}/$repo"
  done
}

# "display<TAB>path" per entry: from sex (-t meaning its Rex sessions) in Rex,
# from sesh otherwise
entries() {
  if [ -n "$rex" ]; then
    local a=("${@/#-t/-r}")
    paste <(sex list -i "${a[@]}") <(sex list -j "${a[@]}" | jq -r '.[].path')
  else
    sesh list --icons --hide-duplicates --format $'{name}\t{path}' "$@"
  fi
}

# sesh entries (path in the 4th field), minus the worktrees' sessions (listed as worktrees instead)
sessions() {
  entries "$@" |
    awk -F '\t' '{ name = $1; gsub(/\033\[[0-9;]*m/, "", name); sub(/^[^ ]+ /, "", name); print $1 "\t" name "\t\t" $2 }' |
    awk -F '\t' 'FILENAME == ARGV[1] { skip[$2]; next } !($2 in skip)' <(worktrees) -
}

# sesh entries with each repo's worktrees right under its main checkout
list() {
  awk -F '\t' '
    FILENAME == ARGV[1] { wt[$5] = wt[$5] "  " $0 "\n"; next }
    # Before the parent, as fzf lists bottom-up and so shows them under it
    $4 in wt { printf "%s", wt[$4]; delete wt[$4] }
    { print }
    END { for (p in wt) printf "%s", wt[p] }
  ' <(worktrees) <(sessions)
}

case "${1:-}" in
list | worktrees)
  "$1"
  exit
  ;;
sessions)
  shift
  sessions "$@"
  exit
  ;;
dirs)
  fd -H -d 2 -t d -E .Trash . ~ | awk '{ print $0 "\t" $0 }'
  exit
  ;;
esac

self=$0
if [ -n "$rex" ]; then
  fzf=(fzf) mux=rex # runs in a Rex floating pane already
else
  fzf=(fzf-tmux -p 70%,60%) mux=tmux
fi
picked=$(
  "$self" list | "${fzf[@]}" --no-border \
    --ansi --delimiter '\t' --with-nth 1 \
    --list-border \
    --no-sort --prompt '  ' \
    --color 'list-border:6,input-border:3,header-bg:-1,header-border:6' \
    --input-border \
    --header-border \
    --header "^a all  ^t $mux  ^g configs  ^x zoxide  ^w worktrees" \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-b:abort' \
    --bind "ctrl-a:change-prompt(  )+reload($self list)" \
    --bind "ctrl-t:change-prompt(  )+reload($self sessions -t)" \
    --bind "ctrl-g:change-prompt(  )+reload($self sessions -c)" \
    --bind "ctrl-x:change-prompt(  )+reload($self sessions -z)" \
    --bind "ctrl-w:change-prompt($wt_icon  )+reload($self worktrees)"
) || exit 0

worktree=$(cut -f3 <<<"$picked")
if [ -n "$worktree" ]; then
  # Quiet: tmux's run-shell would show any output in a view-mode pane
  out=$("$HOME/.config/bin/wt-open" "$(cut -f2 <<<"$picked")" "$worktree" 2>&1) || {
    if [ -n "$rex" ]; then
      printf 'wt-open failed: %s\nPress Enter.' "$out"
      read -r _
    else
      tmux display-message -d 5000 "wt-open failed: $out"
    fi
  }
elif [ -n "$rex" ]; then
  sex connect "$(cut -f2 <<<"$picked")"
else
  sesh connect "$(cut -f2 <<<"$picked")"
fi
