{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@dietrichgebert/ponytail"],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "commit", "effect": "allow" },
    { "action": "skill", "resource": "commit-review", "effect": "allow" },
    { "action": "skill", "resource": "pr-feedback-triage", "effect": "allow" },
    { "action": "skill", "resource": "pr", "effect": "allow" },
    { "action": "skill", "resource": "pr-review", "effect": "allow" },
    { "action": "skill", "resource": "rewrite-branch-commits", "effect": "allow" },
  ],
  "providers": {},
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": {},
      },
    },
  },
}
